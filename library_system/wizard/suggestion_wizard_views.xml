<odoo>
    <record id="view_book_suggestion_wizard" model="ir.ui.view">
        <field name="name">book.suggestion.wizard.form</field>
        <field name="model">suggestion.wizard</field>
        <field name="arch" type="xml">
            <form string="Suggested Books">
                <group>
                    <field name="loan_id" readonly="1"/>

                    <field name="suggested_book_ids"
                           widget="many2many_tags"
                           readonly="1"/>
                    <field name="message" readonly="1"/>

                </group>

                <footer>
                    <button name="action_suggest"
                            string="Generate Suggestions"
                            type="object"
                            class="btn-primary"/>

                    <button string="Close"
                            class="btn-secondary"
                            special="cancel"/>
                </footer>
            </form>
        </field>
    </record>

</odoo>