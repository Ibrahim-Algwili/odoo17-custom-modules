<odoo>
    <!-- Book Category -->
    <record id="product_category_books" model="product.category">
        <field name="name">Books</field>
    </record>

    <!-- Loans Smart Button -->
    <record id="product_template_form_inherit_loan_button" model="ir.ui.view">
        <field name="name">product.template.form.loan.smart.button</field>
        <field name="model">product.template</field>
        <field name="inherit_id" ref="product.product_template_only_form_view"/>
        <field name="arch" type="xml">

            <!-- Smart Button For Loans -->
            <xpath expr="//div[@name='button_box']" position="inside">

                <button
                        name="action_view_loans"
                        type="object"
                        class="oe_stat_button"
                        icon="fa-book"
                        invisible="loan_count == 0"
                >
                    <field name="loan_count" widget="statinfo" string="Loans"/>
                </button>

            </xpath>

        </field>
    </record>

    <!-- Edit Product Form -->
    <record id="books_product_inherit_form" model="ir.ui.view">
        <field name="name">books.product.inherit.form</field>
        <field name="model">product.template</field>
        <field name="inherit_id" ref="product.product_template_form_view"/>
        <field name="arch" type="xml">

            <!-- active Checkbox -->
            <xpath expr="//field[@name='purchase_ok']/.." position="after">
                <group>
                    <field name="is_book" string="Is a Book"/>
                </group>
            </xpath>


            <xpath expr="//sheet/notebook" position="inside">
                <page string="Library" invisible="not is_book">
                    <group>
                        <field name="isbn"/>
                        <field name="author_id"/>
                        <field name="tag_ids" widget="many2many_tags"/>
                    </group>
                </page>
            </xpath>

        </field>
    </record>

    <!-- Kanban View for Library Books -->
    <record id="view_library_books_kanban" model="ir.ui.view">
        <field name="name">library.books.kanban</field>
        <field name="model">product.template</field>
        <field name="arch" type="xml">
            <kanban>
                <field name="name"/>
                <field name="image_1920"/>
                <field name="author_id"/>
                <field name="qty_available"/>
                <templates>
                    <t t-name="kanban-box">
                        <div class="oe_kanban_card">
                            <div class="oe_kanban_global_click">
                                <div class="oe_kanban_image">
                                    <img t-att-src="image_1920 and 'data:image/png;base64,%s' % image_1920 or '/web/static/src/img/placeholder.png'"/>
                                </div>
                                <div class="oe_kanban_details">
                                    <strong t-esc="name"/>
                                    <div>
                                        <span>Author:</span>
                                        <span t-esc="author_id.name"/>
                                    </div>
                                    <div>
                                        <span>Qty:</span>
                                        <span t-esc="qty_available"/>
                                    </div>
                                </div>
                            </div>
                        </div>
                    </t>
                </templates>
            </kanban>
        </field>
    </record>

    <record id="books_product_inherit_search" model="ir.ui.view">
        <field name="name">books.product.inherit.search</field>
        <field name="model">product.template</field>
        <field name="inherit_id" ref="product.product_template_search_view"/>
        <field name="arch" type="xml">
            <search>
                <filter name="tag_ids" string="Tag" context="{'group_by' : 'tag_ids'}"/>
            </search>
        </field>
    </record>

    <!-- Action Window (Shows the books from products) -->
    <record id="action_library_books" model="ir.actions.act_window">
        <field name="name">Library Books</field>
        <field name="res_model">product.template</field>
        <field name="view_mode">kanban,tree,form</field>
        <field name="domain">[('categ_id', '=', 13)]</field>
        <field name="context">{'default_categ_id': 13}</field>
    </record>

</odoo>
