<?xml version="1.0" encoding="UTF-8" ?>
<odoo>

    <!-- Tree View -->
    <record id="lib_book_tree" model="ir.ui.view" >
        <field name="name">lib.book.tree</field>
        <field name="model">lib.book</field>
        <field name="arch" type="xml">
            <tree>
                <field name="name" />
                <field name="isbn" />
                <field name="available_copies" />
                <field name="total_copies" />
            </tree>
        </field>
    </record>

    <!-- Form View -->
    <record id="lib_book_form" model="ir.ui.view" >
        <field name="name">lib.book.form</field>
        <field name="model">lib.book</field>
        <field name="arch" type="xml">
            <form>
                <sheet>
                    <h1>
                        <field name="image" widget="image" class="oe_avatar" />
                    </h1>

                    <div class="oe_title">
                        <label for="name" string="Name" />
                        <h1>
                            <field name="name" />
                        </h1>
                    </div>


                    <group>
                        <field name="isbn" />
                        <field name="available_copies" />
                        <field name="total_copies" />
                    </group>
                </sheet>
            </form>
        </field>
    </record>


    <!-- Window Action -->
    <record id="lib_book_window_action" model="ir.actions.act_window" >
        <field name="name">Books</field>
        <field name="res_model">lib.book</field>
        <field name="view_mode" >tree,form,kanban</field>
        <field name="help" type="html" >
            <p class="o_view_nocontent_smiling_face">
                Create New Book
            </p>
        </field>
    </record>

</odoo>