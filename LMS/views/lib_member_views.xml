<?xml version="1.0" encoding="UTF-8" ?>
<odoo>

    <!-- Tree View -->
    <record id="lib_author_tree" model="ir.ui.view" >
        <field name="name">lib.author.tree</field>
        <field name="model">lib.author</field>
        <field name="arch" type="xml">
            <tree>
                <field name="name" />
                <field name="birth_date" />
            </tree>
        </field>
    </record>

    <!-- Form View -->
    <record id="lib_author_form" model="ir.ui.view" >
        <field name="name">lib.author.form</field>
        <field name="model">lib.author</field>
        <field name="arch" type="xml">
            <form>
                <sheet>
                    <h1>
                        <field name="image" widget="image" class="oe_avatar" />
                    </h1>

                    <div class="oe_title">
                        <label for="name" string="Name" />
                        <h1>
                            <field name="name" />
                        </h1>
                    </div>

                    <group>
                        <field name="birth_date" />
                    </group>

                    <!-- Notebook for books -->
                    <notebook>
                        <page string="Books">
                            <field name="book_ids" readonly="1" >
                                <tree>
                                    <field name="name" />
                                    <field name="isbn" />
                                    <field name="image" widget="image" class="oe_avatar"/>
                                </tree>
                            </field>
                        </page>
                    </notebook>
                </sheet>
            </form>
        </field>
    </record>


    <!-- Window Action -->
    <record id="lib_author_window_action" model="ir.actions.act_window" >
        <field name="name">Books</field>
        <field name="res_model">lib.author</field>
        <field name="view_mode" >tree,form</field>
        <field name="help" type="html" >
            <p class="o_view_nocontent_smiling_face">
                Create New Author
            </p>
        </field>
    </record>

</odoo>