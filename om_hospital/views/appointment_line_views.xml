<?xml version="1.0" encoding="UTF-8" ?>
<odoo>


    <!-- Tree View -->
    <record id="view_hospital_appointment_tree" model="ir.ui.view">
        <field name="name">hospital.appointment.tree</field>
        <field name="model">hospital.appointment</field>
        <field name="arch" type="xml">
            <tree string="Appointments">
                <field name="patient_id"/>
                <field name="date_appointment" optional="show"/>
                <field name="note" optional="hide"/>
                <field name="state"/>
            </tree>
        </field>
    </record>

    <!-- Form View -->
    <record id="view_hospital_appointment_form" model="ir.ui.view">
        <field name="name">hospital.appointment.form</field>
        <field name="model">hospital.appointment</field>
        <field name="arch" type="xml">
            <form string="Appointments">
                <header>
                    <!-- Buttons -->
                    <button name="action_draft" type="object" string="Set to Draft"
                            class="oe_highlight" invisible="state != 'cancelled'"/>
                    <button name="action_confirm" type="object" string="Confirm"
                            class="btn-primary" invisible="state != 'draft'"/>
                    <button name="action_ongoing" type="object" string="On Going"
                            class="btn-secondary" invisible="state not in ('confirmed',)"/>
                    <button name="action_done" type="object" string="Done"
                            class="btn-success" invisible="state != 'ongoing'"/>
                    <button name="action_cancel" type="object" string="Cancel"
                            class="btn-danger"/>


                    <field name="state" widget="statusbar" options="{'clickable' : 1}"/>
                </header>
                <sheet>
                    <div class="oe_title">
                        <label for="reference"/>
                        <h1>
                            <field name="reference" readonly="1"/>
                        </h1>
                        <label for="patient_id"/>
                        <h2>
                            <field name="patient_id"/>
                        </h2>
                    </div>
                    <group>
                        <group>
                            <field name="date_appointment"/>
                        </group>

                    </group>

                    <notebook>
                        <page name="appointment_lines" string="Appointment Lines">
                            <field name="line_ids" >
                                <tree editable="bottom">
                                    <field name="product_id" />
                                    <field name="qty" />
                                </tree>
                            </field>
                        </page>

                        <page name="other_info" string="Other Info">
                            <field name="note" />
                        </page>
                    </notebook>
                </sheet>
                <!-- Chatter -->
                <div class="oe_chatter">
                    <!-- those are fields in the mail table (model) -->
                    <field name="message_follower_ids"/>
                    <field name="activity_ids"/>
                    <field name="message_ids"/>
                </div>
            </form>
        </field>
    </record>

    <!-- Window Action -->
    <record id="action_hospital_appointment" model="ir.actions.act_window">
        <field name="name">Appointments</field>
        <field name="res_model">hospital.appointment</field>
        <field name="view_mode">tree,form</field>
        <!-- to make difference between the views for the same form -->
        <!--        <field name="view_ids" eval="[(5, 0, 0),-->
        <!--            (0, 0, {'view_mode': 'tree', 'view_id': ref('view_hospital_patient_tree')}),-->
        <!--            (0, 0, {'view_mode': 'form', 'view_id': ref('view_hospital_patient_form')})]"/>-->
        <field name="help" type="html">
            <p class="o_view_nocontent_smiling_face">
                Create New Appointment
            </p>
        </field>
    </record>

</odoo>